{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:docling-rs:semantic-fixture-cases:1",
  "title": "Source-grounded PDF semantic fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reference_notes": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "contains"
          ]
        }
      ],
      "properties": {
        "equals": {
          "type": "string",
          "minLength": 1
        },
        "contains": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "name",
        "cells"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cells": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "source_git_blob",
        "source_url",
        "original_pdf_pages",
        "bindings",
        "reference_json",
        "reference_git_blob"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_git_blob": {
          "$ref": "#/$defs/blob"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "original_pdf_pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "reference_json": {
          "type": "string",
          "minLength": 1
        },
        "reference_git_blob": {
          "$ref": "#/$defs/blob"
        },
        "text_anchors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reading_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rights_status": {
          "type": "string",
          "minLength": 1
        },
        "review_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blob": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
